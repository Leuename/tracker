# Committed on purpose. Both values are public by design: they ship inside the
# browser bundle on every build, so keeping them out of the repository would
# protect nothing. Row access is enforced by row-level security policies in
# Postgres, not by keeping this key secret.
#
# A service_role or other secret key must NEVER go in here, or in any VITE_
# variable — Vite sends all of them to the client.
#
# To move these into Vercel's project settings instead, add both under
# Settings > Environment Variables and delete this file.
VITE_SUPABASE_URL=https://jusifpditdigqdjiwdaj.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_6S0d2c8trCgV-fmODw8VYg_XOt7jFXt
