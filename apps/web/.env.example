# Copy to .env.local. Both values are safe to expose in the browser bundle:
# row access is enforced by RLS policies, not by keeping the key secret.
# Never put the service_role or any secret key here — Vite ships every
# VITE_-prefixed variable to the client.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# The scheduler (`npm run schedule`) signs in as a real account to generate this
# month's recurring payables, so it needs credentials of its own. Names only —
# never a real value in this file, and never a service_role key: Vite ships every
# VITE_-prefixed variable to the browser, and this file is the template everyone
# copies. Fill them in .env.local, which is git-ignored.
#
# The scheduler WRITES to the ledger and must be an administrator; BACKUP_* only
# reads. There is deliberately no fallback between them — a fallback would hide
# which privilege each credential carries.
#
# To try it without writing anything:
#   SCHEDULE_EMAIL=… SCHEDULE_PASSWORD=… npm run schedule -- --dry-run
#
# In CI these come from the BACKUP_* repository secrets, mapped in
# .github/workflows/schedule.yml.
SCHEDULE_EMAIL=you@example.com
SCHEDULE_PASSWORD=put-it-in-env-local-not-here

# The exchange-rates job (`npm run fx`, .github/workflows/fx.yml). Names only.
#
# This is NOT an administrator and must not be one. Its profiles.role is
# 'viewer', so is_viewer() refuses it on every table in the ledger; one policy
# naming its uid lets it write fx_rates and nothing else. Deliberately a
# different account from BACKUP_*/SCHEDULE_*, and there is no fallback to them:
# the backup only reads, the scheduler writes payables, and this one writes
# rates. Sharing a credential across those would undo the separation.
FX_EMAIL=
FX_PASSWORD=
